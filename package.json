{
  "name": "investor-portal",
  "version": "1.0.0",
  "private": true,
  "description": "Investor Installment Portal - admin-only installment collection with bKash payment links, SMS reminders and audit trail. Single Node process serves the API and the built React app.",
  "type": "module",
  "engines": {
    "node": ">=22.9.0"
  },
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build --workspace client && node scripts/verify-build.mjs",
    "start": "node server/server.js",
    "verify:build": "node scripts/verify-build.mjs",
    "verify:deploy": "node scripts/verify-deploy.mjs",
    "migrate": "node --env-file-if-exists=.env server/src/db/migrate.js",
    "seed": "node --env-file-if-exists=.env server/src/db/seed.js",
    "test": "node --env-file-if-exists=.env --test --test-concurrency=1 \"server/tests/*.test.js\"",
    "test:unit": "node --env-file-if-exists=.env --test --test-concurrency=1 \"server/tests/unit.*.test.js\"",
    "check": "node scripts/check-env.mjs",
    "db:check": "node --env-file-if-exists=.env server/src/db/check.js"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "vite": "^5.4.11"
  }
}

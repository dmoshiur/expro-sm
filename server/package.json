{
  "name": "@investor-portal/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API server (Express + Turso/libSQL). Also serves the built React client from client/dist.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch --env-file-if-exists=../.env server.js",
    "migrate": "node --env-file-if-exists=../.env src/db/migrate.js",
    "seed": "node --env-file-if-exists=../.env src/db/seed.js",
    "db:check": "node --env-file-if-exists=../.env src/db/check.js"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "express": "^4.21.2"
  }
}

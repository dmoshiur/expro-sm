{
  "name": "@investor-portal/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API server (Express + pg). Also serves the built React client from client/dist.",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file=../.env server.js",
    "dev": "node --watch --env-file=../.env server.js",
    "migrate": "node --env-file=../.env src/db/migrate.js",
    "seed": "node --env-file=../.env src/db/seed.js"
  },
  "dependencies": {
    "express": "^4.21.2",
    "pg": "^8.13.1"
  }
}

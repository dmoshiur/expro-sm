            "description": "ACCOUNTANT or SUPER_ADMIN. Reference is mandatory; amount may not exceed the outstanding balance."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.paymentId) pm.collectionVariables.set('paymentId', data.paymentId);"
                ]
              }
            }
          ]
        },
        {
          "name": "List payments",
          "request": {
            "method": "GET",

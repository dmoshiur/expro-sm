{
  "info": {
    "name": "Investor Installment Portal",
    "description": "Admin-only installment collection API.\n\n**Auth** \u2014 run *Auth / Login* first; Postman stores the httpOnly cookies in the collection's cookie jar.\n\n**Money** \u2014 every amount is an integer number of poisha (1 BDT = 100 poisha) returned as a string.\n\n**Variables** \u2014 `baseUrl`, `investorId`, `investmentId`, `installmentId`, `paymentId`, `adminId`, `token` are filled in automatically by the test scripts, so the folder can be run top to bottom.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000"
    },
    {
      "key": "email",
      "value": "admin@investorportal.local"
    },
    {
      "key": "password",
      "value": "Admin@12345"
    },
    {
      "key": "investorId",
      "value": ""
    },
    {
      "key": "investmentId",
      "value": ""
    },
    {
      "key": "installmentId",
      "value": ""
    },
    {
      "key": "paymentId",
      "value": ""
    },
    {
      "key": "adminId",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. System",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/health",
            "description": "Liveness + database probe."
          }
        }
      ]
    },
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "description": "Signs in and stores the ip_access/ip_refresh cookies. Add `totp` when 2FA is enabled."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.admin) { pm.collectionVariables.set('adminId', data.admin.id); }",
                  "pm.test('signed in or 2FA challenge', () => pm.expect([200]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "Current profile",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/auth/me",
            "description": "Admin profile + mustEnable2FA."
          }
        },
        {
          "name": "2FA setup",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/auth/2fa/setup",
            "description": "Returns the otpauth URL and a QR data URL."
          }
        },
        {
          "name": "2FA verify",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/2fa/verify",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"123456\"\n}"
            }
          }
        },
        {
          "name": "Change password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/change-password",
            "description": "Revokes every session, including this one.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"Admin@12345\",\n  \"newPassword\": \"NewPassword12345\"\n}"
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/auth/logout",
            "description": ""
          }
        }
      ]
    },
    {
      "name": "2. Admins (super admin)",
      "item": [
        {
          "name": "List admins",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/admins?page=1&pageSize=20",
            "description": ""
          }
        },
        {
          "name": "Create admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/admins",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ayesha Accountant\",\n  \"email\": \"accountant@example.com\",\n  \"password\": \"Accountant12345\",\n  \"role\": \"ACCOUNTANT\"\n}"
            },
            "description": "SUPER_ADMIN only. The new admin must change this password and enable 2FA."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json(); if (data.admin) pm.collectionVariables.set('adminId', data.admin.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Update admin",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/admins/{{adminId}}",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"VIEWER\"\n}"
            }
          }
        },
        {
          "name": "Reset password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/admins/{{adminId}}/reset-password",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"newPassword\": \"ResetPassword12345\"\n}"
            }
          }
        },
        {
          "name": "Reset 2FA",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/admins/{{adminId}}/reset-2fa",
            "description": ""
          }
        },
        {
          "name": "Unlock admin",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/admins/{{adminId}}/unlock",
            "description": ""
          }
        }
      ]
    },
    {
      "name": "3. Investors",
      "item": [
        {
          "name": "Create investor",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/investors",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Md. Rahim Uddin\",\n  \"mobile\": \"01712345678\",\n  \"nid\": \"1990123456789\",\n  \"address\": \"House 12, Road 5, Mirpur, Dhaka\"\n}"
            },
            "description": "NID is stored AES-256-GCM encrypted with a unique hash for duplicate detection."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json(); if (data.investor) pm.collectionVariables.set('investorId', data.investor.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List investors",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/investors?search=Rahim&status=ACTIVE&sort=createdAt:desc&page=1&pageSize=20",
            "description": ""
          }
        },
        {
          "name": "Investor detail",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/investors/{{investorId}}",
            "description": "Profile, nominees, investments and recent SMS."
          }
        },
        {
          "name": "Update investor",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/investors/{{investorId}}",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Md. Rahim Uddin\",\n  \"address\": \"Uttara, Dhaka\"\n}"
            }
          }
        },
        {
          "name": "Set nominees (max 3, 100%)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/investors/{{investorId}}/nominees",
            "description": "SUPER_ADMIN only. The database enforces at most three nominees and a 100% total.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nominees\": [\n    {\n      \"name\": \"Rahima Begum\",\n      \"relation\": \"Spouse\",\n      \"mobile\": \"01712345679\",\n      \"sharePercent\": 60\n    },\n    {\n      \"name\": \"Sadia Uddin\",\n      \"relation\": \"Daughter\",\n      \"mobile\": \"01712345680\",\n      \"sharePercent\": 40\n    }\n  ]\n}"
            }
          }
        },
        {
          "name": "Deactivate investor",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/investors/{{investorId}}/deactivate",
            "description": "Soft delete: payment links and reminders stop immediately, history is preserved."
          }
        },
        {
          "name": "Reactivate investor",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/investors/{{investorId}}/reactivate",
            "description": ""
          }
        },
        {
          "name": "NID scan URL (super admin)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/investors/{{investorId}}/nid-scan-url",
            "description": "Returns a short-lived signed URL; the read is audited."
          }
        }
      ]
    },
    {
      "name": "4. Investments & installments",
      "item": [
        {
          "name": "Create investment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/investments",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"investorId\": \"{{investorId}}\",\n  \"totalAmount\": \"120000\",\n  \"installmentCount\": 12,\n  \"firstDueDate\": \"2026-11-05\",\n  \"interval\": {\n    \"unit\": \"MONTH\",\n    \"value\": 1\n  },\n  \"notes\": \"Agreement 2026-11\"\n}"
            },
            "description": "Splits the total into equal poisha amounts with the remainder on the LAST installment, then validates the sum in the database."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.investment) {",
                  "  pm.collectionVariables.set('investmentId', data.investment.id);",
                  "  if (data.investment.installments?.length) pm.collectionVariables.set('installmentId', data.investment.installments[0].id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "List investments",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/investments?status=ACTIVE&page=1&pageSize=20",
            "description": ""
          }
        },
        {
          "name": "Investment detail",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/investments/{{investmentId}}",
            "description": ""
          }
        },
        {
          "name": "Edit schedule (pre-payment)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/investments/{{investmentId}}/installments",
            "description": "Rejected once any payment has been received for the investment.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"totalAmount\": \"150000\",\n  \"interval\": {\n    \"unit\": \"MONTH\",\n    \"value\": 1\n  }\n}"
            }
          }
        },
        {
          "name": "List installments",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/installments?status=PENDING&page=1&pageSize=20",
            "description": ""
          }
        },
        {
          "name": "Waive installment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/installments/{{installmentId}}/waive",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Settled early against the agreement\"\n}"
            }
          }
        },
        {
          "name": "Reopen installment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/installments/{{installmentId}}/reopen",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Waived in error\"\n}"
            }
          }
        },
        {
          "name": "Cancel investment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/investments/{{investmentId}}/cancel",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Agreement withdrawn\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "5. Payment links & SMS",
      "item": [
        {
          "name": "Send link for installment",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/payments/installments/{{installmentId}}/link/send",
            "description": "Generates a fresh token, SMSes the link and records the delivery attempt."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.url) pm.collectionVariables.set('token', String(data.url).split('/pay/').pop());"
                ]
              }
            }
          ]
        },
        {
          "name": "Regenerate link",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/payments/installments/{{installmentId}}/link/regenerate",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sendSms\": false\n}"
            },
            "description": "Invalidates the previous link immediately (only the new hash is stored)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.url) pm.collectionVariables.set('token', String(data.url).split('/pay/').pop());"
                ]
              }
            }
          ]
        },
        {
          "name": "Send all links for an investment",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/payments/investments/{{investmentId}}/links/send",
            "description": ""
          }
        },
        {
          "name": "SMS log",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/payments/sms-logs?page=1&pageSize=25",
            "description": "Destination is masked unless the caller is a SUPER_ADMIN."
          }
        }
      ]
    },
    {
      "name": "6. Public payment (investor side)",
      "item": [
        {
          "name": "Public config",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/public/config",
            "description": "Company name, support mobile, gateway mode."
          }
        },
        {
          "name": "Payment details by token",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/public/payments/{{token}}",
            "description": "Minimal data only: first name, installment no, amount, due date. Rate limited."
          }
        },
        {
          "name": "Start bKash payment",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/public/payments/{{token}}/start",
            "description": "Creates the Payment row and returns redirectUrl. The amount comes from the database."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.paymentId) pm.collectionVariables.set('paymentId', data.paymentId);",
                  "// in dev the mock gateway returns a callback URL: 'Open' it to settle the payment",
                  "if (data.redirectUrl) console.log('Open this URL to complete the payment:', data.redirectUrl);",
                  "pm.test('session started', () => pm.expect(pm.response.code).to.equal(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "7. Payments & receipts",
      "item": [
        {
          "name": "Record manual payment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/payments/installments/{{installmentId}}/manual",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": \"5000\",\n  \"method\": \"BANK\",\n  \"reference\": \"BANK-SLIP-99321\",\n  \"note\": \"Deposited at the branch\"\n}"

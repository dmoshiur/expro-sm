// ---------------------------------------------------------------------------
// Investor Installment Portal - Prisma schema
//
// DATABASE: Turso (libSQL / SQLite compatible).
//   DATABASE_URL = libsql://<db>-<org>.turso.io   (remote, needs TURSO_AUTH_TOKEN)
//   DATABASE_URL = file:./prisma/dev.db           (local development / tests)
//
// MONEY RULE: every monetary value is stored as INTEGER POISHA (1 BDT = 100
// poisha) and is NEVER a float. SQLite INTEGER is a 64-bit signed integer, so
// Prisma maps BigInt -> INTEGER and -> JS BigInt without any precision loss.
// Formatting to BDT happens in the UI / receipt layer only.
//
// NOTES ON SQLITE/TURSO SEMANTICS
//   * enums are stored as TEXT (Prisma keeps the enum API and validates the
//     values in the client); the migration adds CHECK constraints as a second
//     line of defence.
//   * `Json` columns are stored as JSON text and are read/written by Prisma as
//     normal JS objects.
//   * DateTime values are stored as ISO-8601 UTC text by the libSQL driver
//     adapter (see src/config/prisma.ts).
//   * SQLite has no deferred constraint triggers, so the "installments must
//     sum to the investment total" and "nominee shares = 100%" invariants are
//     enforced in the service layer and verified by scripts/check-invariants.mjs.
// ---------------------------------------------------------------------------

// engineType is not configurable in Prisma 7: the client is always the
// Rust-free TypeScript client and always runs on a driver adapter.
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

datasource db {
  provider = "sqlite"
}

// ----------------------------- enums ---------------------------------------

enum AdminRole {
  SUPER_ADMIN
  ACCOUNTANT
  VIEWER
}

enum InvestorStatus {
  ACTIVE
  INACTIVE
}

enum InvestmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum InstallmentStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
  WAIVED
  CANCELLED
}

enum PaymentGateway {
  BKASH
  NAGAD
  MANUAL
}

enum PaymentStatus {
  INITIATED
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  BKASH
  CASH
  BANK
  OTHER
}

enum SmsStatus {
  QUEUED
  SENT
  FAILED
}

enum SmsPurpose {
  PAYMENT_LINK
  REMINDER_DUE
  REMINDER_OVERDUE
  MANUAL
  BULK
}

// ----------------------------- admins --------------------------------------

model Admin {
  id               String    @id @default(uuid())
  name             String
  email            String    @unique
  passwordHash     String
  role             AdminRole @default(VIEWER)
  /// TOTP secret, AES-256-GCM encrypted at rest (see utils/encryption.ts)
  twoFASecret      String?
  twoFAEnabled     Boolean   @default(false)
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  isActive         Boolean   @default(true)
  lastLoginAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  refreshTokens    RefreshToken[]
  auditLogs        AuditLog[]
  paymentsRecorded Payment[]      @relation("PaymentRecordedBy")

  @@index([role])
  @@index([isActive])
  @@map("admins")
}

/// Refresh-token rotation store. Only the SHA-256 hash of the token is kept.
model RefreshToken {
  id             String    @id @default(uuid())
  adminId        String
  tokenHash      String    @unique
  expiresAt      DateTime
  revokedAt      DateTime?
  replacedByHash String?
  ip             String?
  userAgent      String?
  createdAt      DateTime  @default(now())

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ----------------------------- investors -----------------------------------

model Investor {
  id            String         @id @default(uuid())
  name          String
  mobile        String         @unique
  /// NID number, AES-256-GCM encrypted at rest
  nidEncrypted  String?
  /// HMAC-SHA256(NID) - deterministic, used for uniqueness + search only
  nidHash       String?        @unique
  address       String?
  photoPublicId String?
  /// Cloudinary public_id of the private (authenticated) NID scan
  nidPublicId   String?
  status        InvestorStatus @default(ACTIVE)
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  nominees    Nominee[]
  investments Investment[]
  smsLogs     SmsLog[]

  @@index([status])
  @@index([name])
  @@index([createdAt])
  @@map("investors")
}

model Nominee {
  id           String  @id @default(uuid())
  investorId   String
  name         String
  relation     String
  mobile       String
  /// NID, AES-256-GCM encrypted at rest
  nidEncrypted String?
  sharePercent Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  investor Investor @relation(fields: [investorId], references: [id], onDelete: Cascade)

  @@index([investorId])
  @@map("nominees")
}

// ----------------------------- investments ---------------------------------

model Investment {
  id               String           @id @default(uuid())
  investorId       String
  totalAmount      BigInt
  installmentCount Int
  status           InvestmentStatus @default(ACTIVE)
  notes            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  investor     Investor      @relation(fields: [investorId], references: [id], onDelete: Restrict)
  installments Installment[]

  @@index([investorId])
  @@index([status])
  @@index([createdAt])
  @@map("investments")
}

model Installment {
  id              String            @id @default(uuid())
  investmentId    String
  serial          Int
  amount          BigInt
  paidAmount      BigInt            @default(0)
  dueDate         DateTime
  status          InstallmentStatus @default(PENDING)
  /// SHA-256 hash of the payment-link token. The raw token is NEVER stored.
  payTokenHash    String?           @unique
  tokenExpiresAt  DateTime?
  lastRemindedAt  DateTime?
  paidAt          DateTime?
  waivedReason    String?
  cancelledReason String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  investment Investment @relation(fields: [investmentId], references: [id], onDelete: Cascade)
  payments   Payment[]
  smsLogs    SmsLog[]

  @@unique([investmentId, serial])
  @@index([status, dueDate])
  @@index([dueDate])
  @@index([investmentId])
  @@map("installments")
}

// ----------------------------- payments ------------------------------------

model Payment {
  id                String        @id @default(uuid())
  installmentId     String
  gateway           PaymentGateway
  gatewayPaymentId  String?       @unique
  /// bKash/Nagad transaction id. A partial unique index on (gateway, trxId)
  /// WHERE trxId IS NOT NULL is added in the migration SQL.
  trxId             String?
  amount            BigInt
  status            PaymentStatus @default(INITIATED)
  method            PaymentMethod
  manualReference   String?
  note              String?
  receiptNumber     String?       @unique
  recordedByAdminId String?
  rawResponse       Json?
  failureReason     String?
  completedAt       DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  installment     Installment @relation(fields: [installmentId], references: [id], onDelete: Cascade)
  recordedByAdmin Admin?      @relation("PaymentRecordedBy", fields: [recordedByAdminId], references: [id], onDelete: SetNull)

  @@index([installmentId])
  @@index([status])
  @@index([createdAt])
  @@index([trxId])
  @@index([method])
  @@map("payments")
}

// ----------------------------- audit / sms / settings ----------------------

/// Append-only. DB triggers block UPDATE and DELETE (see the migration SQL).
model AuditLog {
  id        String   @id @default(uuid())
  adminId   String?
  action    String
  entity    String
  entityId  String?
  oldValue  Json?
  newValue  Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  admin Admin? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([adminId])
  @@index([entity, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model SmsLog {
  id                String     @id @default(uuid())
  investorId        String?
  installmentId     String?
  toMobile          String
  body              String
  provider          String
  purpose           SmsPurpose @default(PAYMENT_LINK)
  status            SmsStatus  @default(QUEUED)
  providerMessageId String?
  error             String?
  sentAt            DateTime?
  createdAt         DateTime   @default(now())

  investor    Investor?    @relation(fields: [investorId], references: [id], onDelete: SetNull)
  installment Installment? @relation(fields: [installmentId], references: [id], onDelete: SetNull)

  @@index([investorId])
  @@index([installmentId])
  @@index([createdAt])
  @@index([status])
  @@map("sms_logs")
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("settings")
}

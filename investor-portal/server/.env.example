# ===========================================================================
# Investor Installment Portal - server environment
# Copy to .env and fill in.  NEVER commit .env.
# ===========================================================================

NODE_ENV=development
PORT=4000
# Comma separated list of allowed browser origins (strict CORS).
# Comma-separated browser origins. Exact matches only in production.
# A single-label wildcard is supported for ephemeral hosts, e.g. https://*.example.com
# (never use "*" in production). Sandbox/live-preview hosts:
# CORS_ORIGINS=http://localhost:5173,https://*.e2b.app
CORS_ORIGINS=http://localhost:5173
# Public base URL of the API (used for building callback URLs handed to bKash)
API_BASE_URL=http://localhost:4000
# Public base URL of the SPA (payment links are emailed/SMSed as {APP_BASE_URL}/pay/:token)
APP_BASE_URL=http://localhost:5173
# Number of proxy hops to trust: 1 = behind Nginx/one load balancer, 0 = direct.
TRUST_PROXY=1

# ----------------------------- database (Turso) ----------------------------
# Turso (libSQL/SQLite). Either a remote database or a local SQLite file.
#
# Default: local SQLite file - no account, no server, no Docker (development).
TURSO_DATABASE_URL="file:./prisma/dev.db"
TURSO_AUTH_TOKEN=""
#
# Remote (required in production - a `file:` database is rejected on hosted
# runtimes):
#   turso db create investor-portal
#   turso db show investor-portal --url        -> TURSO_DATABASE_URL
#   turso db tokens create investor-portal     -> TURSO_AUTH_TOKEN (secret!)
#   TURSO_DATABASE_URL="libsql://investor-portal-<org>.turso.io"
#
# Optional embedded replica - reads come from a local file, writes are still
# forwarded to the primary. Great for a VPS/container far away from the region:
#   TURSO_DATABASE_URL="file:./prisma/replica.db"
#   TURSO_SYNC_URL="libsql://investor-portal-<org>.turso.io"
#   TURSO_SYNC_INTERVAL=60
# TURSO_ENCRYPTION_KEY=""     # optional: encrypts the local replica at rest
#
# Test database used by `npm test` (dropped + re-migrated on every run):
TEST_DATABASE_URL="file:./prisma/test.db"

# --------------------------------- auth ------------------------------------
# openssl rand -hex 48   (>= 32 chars, distinct value per purpose)
JWT_ACCESS_SECRET="replace-me-with-64-hex-chars-access"
JWT_REFRESH_SECRET="replace-me-with-64-hex-chars-refresh-rotation"
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# 32-byte key, base64 or hex. Encrypts NID + TOTP secrets (AES-256-GCM).
# openssl rand -base64 32
ENCRYPTION_KEY="replace-me-with-base64-32-bytes-key-00000="
# 32+ char pepper for the deterministic NID hash (HMAC-SHA256)
NID_HASH_PEPPER="replace-me-with-a-long-random-pepper-string"
COOKIE_DOMAIN=
# Secure cookies require HTTPS. Default false so the local http quick start can
# sign in; production deployments MUST set it to true (the production guardrails
# report `COOKIE_SECURE must be true when deployed over HTTPS` otherwise).
# The test suite also talks plain http.
COOKIE_SECURE=false
# Max consecutive failed logins before the account is locked
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# ------------------------------- bKash ------------------------------------
# sandbox | live
BKASH_MODE=sandbox
# Sandbox default. For live credentials use https://tokenized.pay.bka.sh/v1.2.0-beta.
# If BKASH_BASE_URL is empty, the runtime selects sandbox/live from BKASH_MODE.
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_CALLBACK_URL=http://localhost:4000/api/public/payments/bkash/callback
BKASH_WEBHOOK_ENABLED=false
BKASH_WEBHOOK_SECRET=

# ------------------------------- storage ----------------------------------
# auto = Cloudinary when credentials are present, otherwise local disk
# (development/tests). Production/Vercel validates that Cloudinary is selected
# and configured; ephemeral local storage is never accepted for hosted runtimes.
STORAGE_DRIVER=auto
LOCAL_STORAGE_DIR=local-storage

# ----------------------------- Cloudinary ---------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=investor-portal
# Lifetime (seconds) of the signed URL used to *view* a private NID scan
CLOUDINARY_SIGNED_URL_TTL=300

# -------------------------------- SMS -------------------------------------
# console | bulksmsbd | alpha (add your provider adapter in src/services/sms)
# console is development/test only; hosted deployments require a configured HTTPS gateway.
SMS_PROVIDER=console
SMS_SENDER_ID=InvestPortal
SMS_API_KEY=
SMS_API_SECRET=
SMS_API_URL=

# ------------------------- payment links / jobs ---------------------------
PAYMENT_LINK_TTL_DAYS=7
REMINDER_DAYS_BEFORE=3
# Long-lived Node/VPS worker only. Set false on Vercel and API-only instances.
RUN_JOBS=true
REMINDER_ENABLED=true
# Cron expressions are evaluated in Asia/Dhaka
CRON_TIMEZONE=Asia/Dhaka
CRON_OVERDUE_MARK=5 0 * * *
CRON_REMINDERS=0 9 * * *
CRON_RECONCILE=*/15 * * * *
CRON_TOKEN_CLEANUP=30 2 * * *

# ------------------------------- misc -------------------------------------
LOG_LEVEL=info
# argon2 memory/time cost is fixed in code; this is the legacy knob kept for
# password-hash cost tuning (see services/auth/auth.service.ts)
BCRYPT_ROUNDS=12

# ------------------------------- seed --------------------------------------
# Password for the FIRST super admin created by `npm run seed`. If unset, a
# strong random password is generated and printed once. On Vercel Production, an
# invalid value also falls back to a generated password (with a warning).
# Leave the password EMPTY on hosted deployments: the seed then generates a
# one-time password and prints it. `npm run setup` writes a local password (and
# prints it) into server/.env for the quick start.
SEED_SUPER_ADMIN_EMAIL=admin@investorportal.local
SEED_SUPER_ADMIN_PASSWORD=
SEED_SUPER_ADMIN_NAME=Super Admin

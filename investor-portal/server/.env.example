# ===========================================================================
# Investor Installment Portal - server environment
# Copy to .env and fill in.  NEVER commit .env.
# ===========================================================================

NODE_ENV=development
PORT=4000
# Comma separated list of allowed browser origins (strict CORS).
CORS_ORIGINS=http://localhost:5173
# Public base URL of the API (used for building callback URLs handed to bKash)
API_BASE_URL=http://localhost:4000
# Public base URL of the SPA (payment links are emailed/SMSed as {APP_BASE_URL}/pay/:token)
APP_BASE_URL=http://localhost:5173
TRUST_PROXY=1

# --------------------------- database (Supabase) ---------------------------
# Runtime connection through the Supavisor/pgbouncer pooler (port 6543).
# Keep ?pgbouncer=true&connection_limit=1 for serverless-style pooling.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct connection (port 5432) used ONLY by `prisma migrate` / `prisma db` commands.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
# Local development alternative (scripts/local-postgres.sh):
# DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/investor_portal"
# DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:5432/investor_portal"
# Test database used by `npm test` (must be a SEPARATE database, it is truncated):
TEST_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/investor_portal_test"

# --------------------------------- auth ------------------------------------
# openssl rand -hex 48   (>= 32 chars, distinct value per purpose)
JWT_ACCESS_SECRET="replace-me-with-64-hex-chars-access"
JWT_REFRESH_SECRET="replace-me-with-64-hex-chars-refresh-rotation"
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# 32-byte key, base64 or hex. Encrypts NID + TOTP secrets (AES-256-GCM).
# openssl rand -base64 32
ENCRYPTION_KEY="replace-me-with-base64-32-bytes-key-00000="
# 32+ char pepper for the deterministic NID hash (HMAC-SHA256)
NID_HASH_PEPPER="replace-me-with-a-long-random-pepper-string"
COOKIE_DOMAIN=
COOKIE_SECURE=true
# Max consecutive failed logins before the account is locked
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# ------------------------------- bKash ------------------------------------
# sandbox | live
BKASH_MODE=sandbox
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_CALLBACK_URL=http://localhost:4000/api/public/payments/bkash/callback
BKASH_WEBHOOK_ENABLED=false
BKASH_WEBHOOK_SECRET=

# ------------------------------- storage ----------------------------------
# auto = Cloudinary when credentials are present, otherwise local disk
# (development/tests). Never use `local` in production: the app servers are
# expected to be ephemeral and the files must live in object storage.
STORAGE_DRIVER=auto
LOCAL_STORAGE_DIR=local-storage

# ----------------------------- Cloudinary ---------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=investor-portal
# Lifetime (seconds) of the signed URL used to *view* a private NID scan
CLOUDINARY_SIGNED_URL_TTL=300

# -------------------------------- SMS -------------------------------------
# console | bulksmsbd | alpha (add your provider adapter in src/services/sms)
SMS_PROVIDER=console
SMS_SENDER_ID=InvestPortal
SMS_API_KEY=
SMS_API_SECRET=
SMS_API_URL=

# ------------------------- payment links / jobs ---------------------------
PAYMENT_LINK_TTL_DAYS=7
REMINDER_DAYS_BEFORE=3
REMINDER_ENABLED=true
# Cron expressions are evaluated in Asia/Dhaka
CRON_TIMEZONE=Asia/Dhaka
CRON_OVERDUE_MARK=5 0 * * *
CRON_REMINDERS=0 9 * * *
CRON_RECONCILE=*/15 * * * *
CRON_TOKEN_CLEANUP=30 2 * * *

# ------------------------------- misc -------------------------------------
LOG_LEVEL=info
# 1 = trust the first proxy hop (Nginx). 0 = direct connection.
BCRYPT_ROUNDS=12

# ------------------------------- seed --------------------------------------
# Password for the FIRST super admin created by `npm run seed`. If unset, a
# strong random password is generated and printed once.
SEED_SUPER_ADMIN_EMAIL=admin@investorportal.local
SEED_SUPER_ADMIN_PASSWORD=
SEED_SUPER_ADMIN_NAME=Super Admin

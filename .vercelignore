# Tests
**/tests/
**/*.test.ts
**/*.test.tsx
**/vitest.config.ts
**/coverage/

# Local dev data
local-storage/
*.db
*.db-wal
*.db-shm
*.db-journal
backups/
*.log

# Docs & deploy helpers (server/scripts is NOT ignored: Vercel runs Prisma
# generation plus the production-only migration/bootstrap postbuild hook)
investor-portal/docs/
investor-portal/deploy/
investor-portal/README.md

# Secrets / local env files (Vercel injects production secrets at runtime)
**/.env
**/.env.*
!**/.env.example

# Git
.git/
.gitignore

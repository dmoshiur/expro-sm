# ============================================================================
# Investor Installment Portal - environment template
# Copy to .env and fill in. The server refuses to boot if a REQUIRED var is
# missing or malformed (see server/src/config/index.js).
# ============================================================================

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=3000
# 0.0.0.0 is required for the app to be reachable behind a reverse proxy / in containers
BIND_HOST=0.0.0.0
LOG_LEVEL=info
# Absolute origin used to build investor payment links and gateway callbacks.
PUBLIC_BASE_URL=http://localhost:3000

# --- Database (REQUIRED) -----------------------------------------------------
# Supabase: Project Settings -> Database -> Connection string -> URI (use the
# pooler host, and append ?sslmode=require). Local: postgres://user:pass@localhost:5432/investor_portal
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/investor_portal
# auto = TLS on for any non-localhost host | true | false
DB_SSL=auto
DB_SSL_REJECT_UNAUTHORIZED=false
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=15000
# Apply pending migrations when the server boots (set false to run them by hand)
RUN_MIGRATIONS_ON_START=true

# --- Security (REQUIRED) -----------------------------------------------------
# 32+ random chars.  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# Exactly 64 hex chars (32 bytes) for AES-256-GCM.  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
SESSION_TTL_HOURS=12
SESSION_ROTATE_AFTER_MINUTES=60
# true in production (HTTPS only). Secure cookies are forced on when NODE_ENV=production.
COOKIE_SECURE=false
COOKIE_NAME=ip_session
# Comma separated list of allowed browser origins for state-changing requests.
# Empty = same-origin only (recommended, single process serves the SPA too).
ALLOWED_ORIGINS=
TRUST_PROXY=1

# --- Admin bootstrap / security policy ---------------------------------------
ADMIN_LOCKOUT_THRESHOLD=5
ADMIN_LOCKOUT_MINUTES=15
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_PAY_WINDOW_MS=900000
RATE_LIMIT_PAY_MAX=30
RATE_LIMIT_API_WINDOW_MS=60000
RATE_LIMIT_API_MAX=300
# "Pay with bKash" clicks (per IP, tighter than the page limiter)
RATE_LIMIT_PAY_START_WINDOW_MS=60000
RATE_LIMIT_PAY_START_MAX=10

# --- Payment links -----------------------------------------------------------
PAYMENT_LINK_TTL_DAYS=30

# --- Payments (bKash) --------------------------------------------------------
# PAYMENT_PROVIDER: bkash | mock   (mock = deterministic local fake, no network)
PAYMENT_PROVIDER=mock
# bKash target: sandbox | live   (sandbox is the default and is safe)
BKASH_MODE=sandbox
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
# Callback the investor returns to. Must be publicly reachable and HTTPS in live mode.
BKASH_CALLBACK_URL=
# Optional webhook route (disabled by default, bKash does not require it)
PAYMENTS_WEBHOOK_ENABLED=false
PAYMENTS_WEBHOOK_SECRET=
# How often the reconciliation job re-queries stuck payments (minutes)
RECONCILE_STUCK_AFTER_MINUTES=15

# --- SMS ---------------------------------------------------------------------
# SMS_PROVIDER: console | bulksmsbd | generic  (console logs masked messages)
SMS_PROVIDER=console
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=
SMS_DRY_RUN=true

# --- Jobs (in-process scheduler, Asia/Dhaka = UTC+6, no DST) ------------------
JOBS_ENABLED=true
# Local Dhaka time for the daily sweeps (HH:MM)
JOB_OVERDUE_AT=00:10
JOB_REMINDERS_AT=09:00
JOB_RECONCILE_EVERY_MINUTES=15
# Reminder policy
REMINDER_DAYS_BEFORE=3
OVERDUE_REMINDER_INTERVAL_HOURS=72

# --- Misc --------------------------------------------------------------------
TOTP_ISSUER=Investor Installment Portal
TOTP_WINDOW=1
MAX_UPLOAD_BYTES=2097152
MASK_LOGS=true

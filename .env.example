# ============================================================================
# Investor Installment Portal - environment template
#
# Production (Render): set these in the Render dashboard (Environment tab).
# Do NOT deploy a .env file - the service reads process environment variables.
# Local development: copy to .env and adjust (see the notes on each section).
# The server refuses to boot if a REQUIRED variable is missing or unsafe
# (see server/src/config/index.js and server/src/config/database.js).
# ============================================================================

# --- Runtime -----------------------------------------------------------------
# production on Render. For local development copy this file to .env and set
# NODE_ENV=development (then TURSO_DATABASE_URL may be a local file:... URL).
NODE_ENV=production
# Render injects PORT; keep 4000 as the default for local runs.
PORT=4000
# 0.0.0.0 is required so the process is reachable from Render's proxy / containers.
BIND_HOST=0.0.0.0
LOG_LEVEL=info
# Public origin used to build investor payment links and gateway callbacks (https in production).
PUBLIC_BASE_URL=https://your-service.onrender.com

# --- Database: Turso (libSQL) - REQUIRED -------------------------------------
# libsql://<database-name>-<org>.turso.io   (create with: turso db create ...)
TURSO_DATABASE_URL=
# Token for that database (create with: turso db tokens create <database-name>).
# Secret: store only in the Render dashboard / secret store, never in git.
TURSO_AUTH_TOKEN=
# Apply pending migrations at boot. Keep false in production and run
# `npm run migrate` explicitly (see docs/database.md). Dev default: true.
DB_MIGRATE_ON_START=false

# --- Security (REQUIRED) -----------------------------------------------------
# 32+ random chars.  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# Exactly 64 hex chars (32 bytes) for AES-256-GCM.  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing this makes existing encrypted fields (NID, TOTP secrets, scans) unreadable.
ENCRYPTION_KEY=
SESSION_TTL_HOURS=12
SESSION_ROTATE_AFTER_MINUTES=60
# Secure cookies are forced on when NODE_ENV=production.
COOKIE_SECURE=true
COOKIE_NAME=ip_session
# Comma separated list of allowed browser origins for state-changing requests.
# Empty = same-origin only (recommended, single process serves the SPA too).
ALLOWED_ORIGINS=
# Render terminates TLS in front of the service.
TRUST_PROXY=1

# --- Admin bootstrap / security policy ---------------------------------------
ADMIN_LOCKOUT_THRESHOLD=5
ADMIN_LOCKOUT_MINUTES=15
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_PAY_WINDOW_MS=900000
RATE_LIMIT_PAY_MAX=30
RATE_LIMIT_API_WINDOW_MS=60000
RATE_LIMIT_API_MAX=300
# "Pay with bKash" clicks (per IP, tighter than the page limiter)
RATE_LIMIT_PAY_START_WINDOW_MS=60000
RATE_LIMIT_PAY_START_MAX=10

# --- Seeding (only used by `npm run seed`; required in production) ----------
# No default passwords exist in production. Set strong values, run the seed once,
# then remove these from the Render environment.
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=

# --- Payment links -----------------------------------------------------------
PAYMENT_LINK_TTL_DAYS=30

# --- Payments (bKash) --------------------------------------------------------
# PAYMENT_PROVIDER: bkash | mock   (mock = deterministic local fake, no network)
PAYMENT_PROVIDER=mock
# bKash target: sandbox | live   (sandbox is the default and is safe)
BKASH_MODE=sandbox
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
# Secrets: leave empty here; set in the Render dashboard when PAYMENT_PROVIDER=bkash.
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
# Callback the investor returns to. Must be publicly reachable and HTTPS in live mode.
BKASH_CALLBACK_URL=
# Optional webhook route (disabled by default, bKash does not require it)
PAYMENTS_WEBHOOK_ENABLED=false
PAYMENTS_WEBHOOK_SECRET=
# How often the reconciliation job re-queries stuck payments (minutes)
RECONCILE_STUCK_AFTER_MINUTES=15

# --- SMS ---------------------------------------------------------------------
# SMS_PROVIDER: console | bulksmsbd | generic  (console logs masked messages)
SMS_PROVIDER=console
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=
# Dry run never calls the provider. Keep true until the provider is approved.
SMS_DRY_RUN=true

# --- Jobs (in-process scheduler, Asia/Dhaka = UTC+6, no DST) ------------------
JOBS_ENABLED=true
# Local Dhaka time for the daily sweeps (HH:MM)
JOB_OVERDUE_AT=00:10
JOB_REMINDERS_AT=09:00
JOB_RECONCILE_EVERY_MINUTES=15
# Reminder policy
REMINDER_DAYS_BEFORE=3
OVERDUE_REMINDER_INTERVAL_HOURS=72

# --- Misc --------------------------------------------------------------------
TOTP_ISSUER=Investor Installment Portal
TOTP_WINDOW=1
MAX_UPLOAD_BYTES=2097152
MASK_LOGS=true
